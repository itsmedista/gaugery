# Address to listen on. Use your Tailscale IP (tailscale ip -4) to keep it off the LAN/internet.
HOST=0.0.0.0
PORT=8088

# Seconds between samples, and days of per-minute history to keep.
SAMPLE_INTERVAL=2
RETENTION_DAYS=14

# Login. Generate the hash with: /opt/monitorr/venv/bin/python /opt/monitorr/app.py --hash-password
# (install.sh asks for a password and fills this in). AUTH_DISABLED=true turns login off.
AUTH_USER=admin
AUTH_PASSWORD_HASH=
SESSION_DAYS=30
# Host names this answers to, comma separated (e.g. monitorr.lan,100.64.0.5). Blocks DNS rebinding.
ALLOWED_HOSTS=

# Agent mode: set this when another Monitorr (the hub) should watch this server.
# Make one with: /opt/monitorr/venv/bin/python /opt/monitorr/app.py --new-token
# (install.sh --agent does it for you). Leave AUTH_PASSWORD_HASH empty for an agent-only install.
AGENT_TOKEN=

# Container logs on the dashboard (read-only). Logs can contain secrets; false hides them.
ALLOW_LOGS=true
# Start/stop/restart containers from the dashboard. Every action is logged and sent to ntfy.
ALLOW_CONTAINER_ACTIONS=false

# Push alerts to your phone with ntfy (https://ntfy.sh or your own server). Leave empty to disable.
NTFY_URL=
NTFY_TOKEN=

# Comma-separated mount points to hide, e.g. /mnt/cdrom,/var/lib/something
IGNORE_MOUNTS=

# Alert thresholds
ALERT_CPU=90
ALERT_MEM=90
ALERT_DISK_WARN=85
ALERT_DISK_CRIT=95
ALERT_TEMP_WARN=80
ALERT_TEMP_CRIT=90
ALERT_FILL_DAYS=14
