# Monitorr settings for the systemd install (copied to /etc/monitorr.env, readable by root only).
# After changing: sudo systemctl restart monitorr-agent monitorr

# ---------- the web interface (monitorr.service) ----------
# Listen address. Use your Tailscale IP (tailscale ip -4) to keep it off the LAN/internet.
HOST=0.0.0.0
PORT=8088
# Sign-in. install.sh fills in the hash; make a new one with:
#   sudo -u monitorr /opt/monitorr/venv/bin/python /opt/monitorr/app.py --hash-password
AUTH_USER=admin
AUTH_PASSWORD_HASH=
SESSION_DAYS=30
# HTTPS: "auto" serves it with Monitorr's own certificate. Behind Tailscale serve or a reverse proxy,
# leave it empty, set HOST=127.0.0.1 and TRUSTED_PROXIES=127.0.0.1.
TLS=
TRUSTED_PROXIES=
# Host names you open it with, comma separated (e.g. monitorr.lan,100.64.0.5). Blocks DNS rebinding.
ALLOWED_HOSTS=
# Signing in over plain HTTP is refused from public addresses. Only for special setups:
ALLOW_HTTP_LOGIN=
# Service checks may only reach these networks (empty = anywhere except loopback/link-local/metadata)
CHECK_ALLOWED_NETWORKS=

# ---------- the agent (monitorr-agent.service) ----------
# Shared secret between the web interface and the agent (install.sh makes one).
AGENT_TOKEN=
# Seconds between samples, and days of per-minute history to keep.
SAMPLE_INTERVAL=2
RETENTION_DAYS=14
# Container logs on the dashboard: empty = off, "all", or container names: plex,nginx
ALLOW_LOGS=
# Start/stop/restart buttons: empty = off, "all", or container names. Every action goes to ntfy.
ALLOW_CONTAINER_ACTIONS=
# Drive health (runs smartctl as root): true to turn on
SMART=
# Comma-separated mount points to hide, e.g. /mnt/cdrom,/var/lib/something
IGNORE_MOUNTS=

# ---------- alerts (both) ----------
# Push alerts to your phone with ntfy (https://ntfy.sh or your own server). Leave empty to disable.
# The web interface also sends security events here: new sign-in addresses, changes, container actions.
NTFY_URL=
NTFY_TOKEN=
ALERT_CPU=90
ALERT_MEM=90
ALERT_DISK_WARN=85
ALERT_DISK_CRIT=95
ALERT_TEMP_WARN=80
ALERT_TEMP_CRIT=90
ALERT_FILL_DAYS=14
