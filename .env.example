# Monitorr settings for Docker. ./docker-setup.sh copies this to .env and fills in the secrets.
# .env is ignored by git and readable by you only; never commit it.

# ---------- secrets (filled in by ./docker-setup.sh) ----------
AGENT_TOKEN=
AUTH_PASSWORD_HASH=
AUTH_USER=admin

# ---------- how you reach it ----------
# Listen address and port. Put your Tailscale IP (tailscale ip -4) in BIND to keep it off the LAN.
BIND=0.0.0.0
PORT=8088
# HTTPS: "auto" serves it with Monitorr's own certificate (your browser asks once whether to trust it).
# Using Tailscale serve or another reverse proxy instead? Leave TLS empty, set BIND=127.0.0.1 and
# TRUSTED_PROXIES to the proxy's address (e.g. 172.17.0.1 for a proxy on the host).
TLS=
TRUSTED_PROXIES=
# Host names you open it with, comma separated (e.g. monitorr.lan,100.64.0.5). Blocks DNS rebinding.
ALLOWED_HOSTS=
# Signing in over plain HTTP is refused from public addresses. Only for special setups:
ALLOW_HTTP_LOGIN=

# ---------- what the dashboard may do on this server ----------
# Container logs: empty = off, "all", or container names: plex,nginx
ALLOW_LOGS=
# Start/stop/restart buttons: empty = off, "all", or names. Also set COMPOSE_PROFILES=actions,
# which starts the small proxy that allows exactly those three actions and nothing else.
ALLOW_CONTAINER_ACTIONS=
COMPOSE_PROFILES=
# Drive health needs raw disk access: see docker-compose.smart.yml
# Service checks may only reach these networks (empty = anywhere except loopback/link-local/metadata)
CHECK_ALLOWED_NETWORKS=

# ---------- alerts ----------
# Phone alerts via ntfy, e.g. https://ntfy.sh/your-private-topic. Also gets security events
# (sign-ins from new addresses, servers and checks changed, container actions).
NTFY_URL=
NTFY_TOKEN=
IGNORE_MOUNTS=
ALERT_CPU=90
ALERT_MEM=90
ALERT_DISK_WARN=85
ALERT_DISK_CRIT=95
ALERT_TEMP_WARN=80
ALERT_TEMP_CRIT=90
ALERT_FILL_DAYS=14
